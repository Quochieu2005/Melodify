# Expo LAN replaces localhost with the Metro computer's IP, preserving this port.
# Run Backend with: php artisan serve --host=0.0.0.0 --port=8000
# For Expo Tunnel, use an explicit reachable API URL instead.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Expo Web only.
# Native development builds use SDK tokens with API_URL.
EXPO_PUBLIC_OAUTH_BASE_URL=http://localhost:8000

# Public native SDK configuration. Never put Google Client Secret or Meta App Secret here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
IOS_BUNDLE_IDENTIFIER=com.melodify.mobile
ANDROID_PACKAGE=com.melodify.mobile
