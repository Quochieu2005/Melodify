APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: APP_URL=http://localhost:8000
# Render production: APP_URL=https://melodify-6kc9.onrender.com
ADMIN_EMAIL=admin@melodify.vn
ADMIN_PASSWORD=
ADMIN_INITIAL_PASSWORD=1234567890
API_DOCS_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/auth/facebook/callback
API_TOKEN_TTL_DAYS=30
API_TOKEN_SESSION_TTL_DAYS=1
API_TOKEN_REMEMBER_TTL_DAYS=30
PHONE_OTP_DRIVER=log
PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5
API_PASSWORD_RESET_TTL_MINUTES=5
API_PASSWORD_RESET_RESEND_SECONDS=60
API_PASSWORD_RESET_MAX_ATTEMPTS=5
API_PASSWORD_RESET_TOKEN_TTL_MINUTES=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=melodify
CLOUDINARY_ADMIN_FOLDER=admin
CLOUDINARY_BANNER_FOLDER=banner
CLOUDINARY_ARTIST_FOLDER=melodify/artists
CLOUDINARY_AUDIO_FOLDER=melodify/audio

ITUNES_BASE_URL=https://itunes.apple.com
ITUNES_COUNTRIES=VN,US,CN
ITUNES_API_TIMEOUT=10
NCT_GRAPH_BASE_URL=https://graph.nhaccuatui.com
NCT_USER_AGENT="Melodify/1.0"
NCT_API_TIMEOUT=15
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_USER_AGENT="Melodify/1.0 (local development)"
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=melodify

# MySQL chỉ dùng cho session, cache và queue. Dữ liệu nghiệp vụ vẫn nằm trên MongoDB Atlas.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=melodify
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Database MySQL duy nhất của Melodify: session/cache/queue và replica đọc từ Atlas.

SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql
DB_BATCHING_CONNECTION=mysql
DB_FAILED_CONNECTION=mysql

CACHE_STORE=database
DB_CACHE_CONNECTION=mysql
DB_CACHE_LOCK_CONNECTION=mysql
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
