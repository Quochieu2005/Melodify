APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: APP_URL=http://localhost:8000
# Render production: APP_URL=https://melodify-6kc9.onrender.com
ADMIN_EMAIL=admin@melodify.vn
ADMIN_PASSWORD=
ADMIN_INITIAL_PASSWORD=1234567890
API_DOCS_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
GOOGLE_MOBILE_CLIENT_IDS=
GOOGLE_MOBILE_REDIRECT_URI=mobile://oauth/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/auth/facebook/callback
FACEBOOK_MOBILE_REDIRECT_URI=mobile://oauth/callback
FACEBOOK_GRAPH_VERSION=v23.0
OAUTH_WEB_REDIRECT_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Default artisan server. Use composer dev:mobile for phone access over LAN.
SERVER_HOST=127.0.0.1
API_TOKEN_TTL_DAYS=30
API_TOKEN_SESSION_TTL_DAYS=1
API_TOKEN_REMEMBER_TTL_DAYS=30
PHONE_OTP_DRIVER=log
PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5
API_PASSWORD_RESET_TTL_MINUTES=5
API_PASSWORD_RESET_RESEND_SECONDS=60
API_PASSWORD_RESET_MAX_ATTEMPTS=5
API_PASSWORD_RESET_TOKEN_TTL_MINUTES=10

# Configure these with merchant credentials from the provider dashboards.
# Use the sandbox URLs below for testing; switch to the provider's production
# URLs only after production credentials and HTTPS callback URLs are approved.
PAYMENT_RETURN_URL=http://localhost:3000/mua-vip/ket-qua
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=captureWallet
MOMO_REDIRECT_URL=${APP_URL}/api/v1/vip/payments/momo/return
MOMO_IPN_URL=${APP_URL}/api/v1/vip/payments/momo/ipn
MOMO_PAY_URL_HOSTS=test-payment.momo.vn,payment.momo.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=${APP_URL}/api/v1/vip/payments/vnpay/return
VNPAY_IPN_URL=${APP_URL}/api/v1/vip/payments/vnpay/ipn
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=${APP_URL}/api/v1/vip/payments/zalopay/callback

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=melodify
CLOUDINARY_ADMIN_FOLDER=admin
CLOUDINARY_BANNER_FOLDER=banner
CLOUDINARY_ARTIST_FOLDER=melodify/artists
CLOUDINARY_AUDIO_FOLDER=melodify/audio

ITUNES_BASE_URL=https://itunes.apple.com
ITUNES_COUNTRIES=VN,US,CN
ITUNES_API_TIMEOUT=10
NCT_GRAPH_BASE_URL=https://graph.nhaccuatui.com
NCT_USER_AGENT="Melodify/1.0"
NCT_API_TIMEOUT=15
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT=15
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_USER_AGENT="Melodify/1.0 (local development)"
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=melodify

# MySQL chỉ dùng cho session, cache và queue. Dữ liệu nghiệp vụ vẫn nằm trên MongoDB Atlas.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=melodify
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Database MySQL duy nhất của Melodify: session/cache/queue và replica đọc từ Atlas.

SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql
DB_BATCHING_CONNECTION=mysql
DB_FAILED_CONNECTION=mysql

CACHE_STORE=database
DB_CACHE_CONNECTION=mysql
DB_CACHE_LOCK_CONNECTION=mysql
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
